# ============================================================
# QASSA POS — ENVIRONMENT CONFIGURATION TEMPLATE
# Salin file ini menjadi .env di root project:
# cp .env.example .env (Linux/Mac) atau copy .env.example .env (Windows)
# ============================================================

# 1. Database Connection String (PostgreSQL)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE_NAME?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/pos_universal?schema=public"

# 2. NextAuth Configuration
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="qassa-pos-secure-nextauth-secret-key-change-this-in-production-2026"

# 3. Public App URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# 4. OTP / Email Sender Configuration (Opsional - Gmail SMTP)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_USER=""
SMTP_PASS=""

# 5. WhatsApp Gateway Sender Configuration (Opsional)
WA_SENDER_PHONE=""
WA_GATEWAY_URL=""
WA_GATEWAY_TOKEN=""

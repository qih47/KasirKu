// ============================================================
// SCHEMA DATABASE — APLIKASI KASIR UNIVERSAL
// Berdasarkan PRD-Kasir-Universal.md
// Model: Multi-tenant SaaS dengan billing Lisensi + Plugin + Tema
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// ENUMS
// ============================================================

enum UserRole {
  OWNER
  ADMIN_CABANG // skeleton, belum aktif di MVP
  KASIR
}

enum TenantStatus {
  TRIAL
  ACTIVE
  LOCKED   // trial/langganan habis, belum bayar, transaksi dihentikan
  FROZEN   // lewat grace period, data dibekukan
}

enum BillingCycle {
  MONTHLY
  ANNUAL
}

enum ProductType {
  BARANG
  JASA
}

enum PaymentMethod {
  CASH
  QRIS
  TRANSFER
  CARD
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
}

enum TransactionStatus {
  PENDING
  PAID
  CANCELLED
}

enum ThemeType {
  DEFAULT
  PRESET
  CUSTOM
}

enum BookingStatus {
  WAITING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum LaundryStatus {
  RECEIVED
  WASHING
  DRYING
  IRONING
  READY
  COMPLETED
  CANCELLED
}

enum TableStatus {
  AVAILABLE
  OCCUPIED
  RESERVED
}

// ============================================================
// PLATFORM LAYER
// Terpisah total dari hierarki tenant. Milik Super Admin (pemilik platform).
// ============================================================

model SuperAdmin {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  passwordHash String
  createdAt    DateTime @default(now())

  auditLogs    AuditLog[]

  @@map("super_admins")
}

// Katalog Lisensi (kapasitas & fitur umum) — lihat PRD section 4.1
model LicenseTier {
  id                    String   @id @default(uuid())
  code                  String   @unique // "basic" | "pro" | "enterprise"
  name                  String
  priceMonthly          Decimal  @db.Decimal(12, 2)
  priceAnnual           Decimal  @db.Decimal(12, 2)
  outletLimit           Int?     // null = custom/unlimited (Enterprise)
  kasirLimitPerOutlet   Int?     // null = custom/unlimited
  hasAdminCabang        Boolean  @default(false)
  hasConsolidatedReport Boolean  @default(false)
  hasApiAccess          Boolean  @default(false)
  isActive              Boolean  @default(true)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  subscriptions TenantSubscription[]

  @@map("license_tiers")
}

// Katalog Plugin vertikal — lihat PRD section 4.2
model Plugin {
  id           String   @id @default(uuid())
  code         String   @unique // "barbershop" | "cafe" | "retail" | "laundry"
  name         String
  description  String?
  priceMonthly Decimal  @db.Decimal(12, 2)
  priceAnnual  Decimal  @db.Decimal(12, 2)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenantPlugins TenantPlugin[]

  @@map("plugins")
}

// Katalog Tema — lihat PRD section 4.4
model Theme {
  id           String    @id @default(uuid())
  code         String    @unique
  name         String
  type         ThemeType @default(PRESET)
  priceMonthly Decimal   @default(0) @db.Decimal(12, 2)
  setupFee     Decimal?  @db.Decimal(12, 2) // khusus tema custom
  tokens       Json?     // design tokens: warna, font, spacing
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())

  tenantThemes TenantTheme[]

  @@map("themes")
}

model AuditLog {
  id           String     @id @default(uuid())
  superAdminId String
  superAdmin   SuperAdmin @relation(fields: [superAdminId], references: [id])
  action       String     // "update_price" | "suspend_tenant" | dll
  targetType   String?    // nama tabel/entitas yang diubah
  targetId     String?
  detail       Json?
  createdAt    DateTime   @default(now())

  @@map("audit_logs")
}

model PlatformSetting {
  id        String   @id @default(uuid())
  key       String   @unique
  value     Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("platform_settings")
}


// ============================================================
// TENANT LAYER
// ============================================================

model Tenant {
  id               String       @id @default(uuid())
  businessName     String
  logoUrl          String?      // null = pakai default, hanya aktif jika lisensi/tema mendukung custom branding
  receiptConfig    Json?        // Konfigurasi dinamis struk: logo, pajak, diskon, service charge, checklist komponen
  dashboardWidgets Json?        // Konfigurasi tata letak widget dashboard ringkasan dinamis tenant
  attributes       Json?        // Konfigurasi dinamis fleksibel (misal: service charge rate, dll)
  payrollCutoffDay Int          @default(25) // Tanggal gajian (1-31). Contoh: 25 = cutoff 25 bln lalu s/d 24 bln ini
  status           TenantStatus @default(TRIAL)
  trialStartAt     DateTime?    @default(now())
  trialEndAt       DateTime?
  lockedAt         DateTime?
  gracePeriodEndAt DateTime?
  freezeEndAt      DateTime?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  outlets          Outlet[]
  users            User[]
  subscriptions    TenantSubscription[]
  products         Product[]
  bookings         Booking[]
  commissions      StaffCommission[]
  laundryOrders    LaundryOrder[]
  cafeTables       CafeTable[]
  payrollRecords   PayrollRecord[]

  @@map("tenants")
}

// Struktur cabang. Di MVP biasanya 1 tenant = 1 outlet (sesuai limit Lisensi Basic),
// tapi struktur sudah disiapkan untuk multi-outlet (Lisensi Pro/Enterprise).
model Outlet {
  id             String   @id @default(uuid())
  tenantId       String
  tenant         Tenant   @relation(fields: [tenantId], references: [id])
  name           String
  address        String?
  operatingHours Json?    // Konfigurasi jadwal jam kerja mingguan 7 hari (Senin - Minggu)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())

  users         User[]
  products      Product[]
  outletStocks  OutletStock[]
  transactions  Transaction[]
  shifts        Shift[]
  bookings      Booking[]
  commissions   StaffCommission[]
  laundryOrders LaundryOrder[]
  cafeTables    CafeTable[]

  @@index([tenantId])
  @@map("outlets")
}

model User {
  id                String    @id @default(uuid())
  tenantId          String
  tenant            Tenant    @relation(fields: [tenantId], references: [id])
  outletId          String?   // null untuk Owner (akses semua outlet miliknya)
  outlet            Outlet?   @relation(fields: [outletId], references: [id])
  role              UserRole
  name              String
  email             String
  phone             String?
  passwordHash      String
  position          String?   @default("KASIR") // "KASIR" | "BARISTA" | "WAITER" | "BARBER" | "CHEF" | "PENYETRIKA" | "KURIR" | "STAFF_GUDANG" | "SUPERVISOR" | "CUSTOM"
  hasPosAccess      Boolean   @default(true) // True jika kasir/berhak buka POS (memotong kuota kasir), False jika staf operasional non-login
  employmentType    String?   @default("FULL_TIME") // "FULL_TIME" | "PART_TIME" | "FREELANCE" | "COMMISSION_ONLY"
  joinDate          DateTime? @default(now()) // Tanggal mulai bergabung / bekerja
  baseSalary        Decimal?  @db.Decimal(12, 2) // Gaji pokok periode
  salaryType        String?   @default("MONTHLY") // "MONTHLY" | "PER_SHIFT" | "DAILY" | "NONE"
  allowanceMeal     Decimal?  @db.Decimal(12, 2) // Tunjangan Uang Makan (Opsional)
  allowanceTransport Decimal? @db.Decimal(12, 2) // Tunjangan Transportasi (Opsional)
  allowanceOther    Decimal?  @db.Decimal(12, 2) // Tunjangan Lainnya / Jabatan (Opsional)
  overtimeRate      Decimal?  @db.Decimal(12, 2) // Tarif Uang Lembur per Jam (Opsional)
  isCommissionActive Boolean  @default(false)    // True = Staf berhak atas komisi/bagi hasil POS, False = Pure Gaji
  commissionPercent Float?    // % komisi default (misal 30% untuk barber/kapster)
  commissionFlat    Decimal?  @db.Decimal(12, 2) // Komisi flat per unit (misal Rp 2.000 / Kg untuk laundry)
  attributes        Json?     // Konfigurasi komisi & spesialisasi staf (misal: rate kapster, laundry, dll)
  isActive          Boolean   @default(true)
  createdAt         DateTime  @default(now())

  shifts            Shift[]
  bookings          Booking[]
  commissions       StaffCommission[]
  payrollRecords    PayrollRecord[]

  @@unique([tenantId, email])
  @@index([tenantId])
  @@index([outletId])
  @@index([joinDate])
  @@map("users")
}

// Satu tenant bisa punya lebih dari satu subscription record sepanjang waktu
// (histori upgrade/downgrade/ganti lisensi), tapi hanya 1 yang isActive di satu waktu.
model TenantSubscription {
  id                 String       @id @default(uuid())
  tenantId           String
  tenant             Tenant       @relation(fields: [tenantId], references: [id])
  licenseTierId      String
  licenseTier        LicenseTier  @relation(fields: [licenseTierId], references: [id])
  billingCycle       BillingCycle
  durationMonths     Int?         @default(1)
  durationKey        String?      @default("1M")
  currentPeriodStart DateTime
  currentPeriodEnd   DateTime
  isActive           Boolean      @default(true)
  createdAt          DateTime     @default(now())


  plugins TenantPlugin[]
  theme   TenantTheme?

  @@index([tenantId])
  @@map("tenant_subscriptions")
}

// Plugin vertikal yang diaktifkan tenant. Satu tenant bisa punya >1 plugin aktif
// (misal owner barbershop yang juga buka cafe).
model TenantPlugin {
  id             String             @id @default(uuid())
  subscriptionId String
  subscription   TenantSubscription @relation(fields: [subscriptionId], references: [id])
  pluginId       String
  plugin         Plugin             @relation(fields: [pluginId], references: [id])
  activatedAt    DateTime           @default(now())
  isActive       Boolean            @default(true)

  @@unique([subscriptionId, pluginId])
  @@map("tenant_plugins")
}

model TenantTheme {
  id             String             @id @default(uuid())
  subscriptionId String             @unique
  subscription   TenantSubscription @relation(fields: [subscriptionId], references: [id])
  themeId        String
  theme          Theme              @relation(fields: [themeId], references: [id])
  customConfig   Json?              // override token, khusus tema custom
  activatedAt    DateTime           @default(now())

  @@map("tenant_themes")
}

// ============================================================
// OPERATIONAL LAYER (Core Engine)
// ============================================================

// Produk/jasa generic. Field `attributes` (JSONB) menampung data spesifik
// per vertikal (mis. durasi & komisi untuk barbershop, varian untuk retail)
// tanpa perlu ubah skema tiap kali ada plugin baru.
model Product {
  id         String      @id @default(uuid())
  tenantId   String
  tenant     Tenant      @relation(fields: [tenantId], references: [id])
  outletId   String?
  outlet     Outlet?     @relation(fields: [outletId], references: [id])
  name       String
  imageUrl   String?     // URL gambar produk/jasa
  type       ProductType
  price      Decimal     @db.Decimal(12, 2)
  barcode    String?
  category   String?
  stockQty   Int?        // null jika produk tipe JASA (tidak butuh stok)
  attributes Json?       // field fleksibel per vertikal
  isActive   Boolean     @default(true)
  createdAt  DateTime    @default(now())

  transactionItems TransactionItem[]
  bookings         Booking[]
  outletStocks     OutletStock[]

  @@index([tenantId])
  @@index([outletId])
  @@index([barcode])
  @@map("products")
}

model OutletStock {
  id            String   @id @default(uuid())
  outletId      String
  outlet        Outlet   @relation(fields: [outletId], references: [id], onDelete: Cascade)
  productId     String
  product       Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  stockQty      Int      @default(0)          // snapshot angka stok saat ini di outlet ini
  priceOverride Decimal? @db.Decimal(12, 2)   // null = pakai Product.price
  isAvailable   Boolean  @default(true)       // status aktif produk di outlet ini
  updatedAt     DateTime @updatedAt

  movements StockMovement[]

  @@unique([outletId, productId])
  @@index([outletId])
  @@index([productId])
  @@map("outlet_stocks")
}

model StockMovement {
  id             String      @id @default(uuid())
  outletStockId  String
  outletStock    OutletStock @relation(fields: [outletStockId], references: [id], onDelete: Cascade)
  type           String      // "IN" | "OUT" | "ADJUSTMENT" | "TRANSFER_OUT" | "TRANSFER_IN"
  qty            Int         // selalu positif — arah ditentukan oleh `type`
  note           String?
  referenceId    String?     // transactionItemId, atau transferId jika ada di masa depan
  performedById  String?     // userId yang melakukan perubahan
  status         String      @default("CONFIRMED") // "CONFIRMED" | "PENDING" (untuk transfer)
  createdAt      DateTime    @default(now())

  @@index([outletStockId, createdAt])
  @@index([type, createdAt])
  @@map("stock_movements")
}

model Shift {
  id          String    @id @default(uuid())
  outletId    String
  outlet      Outlet    @relation(fields: [outletId], references: [id])
  kasirId     String
  kasir       User      @relation(fields: [kasirId], references: [id])
  openedAt    DateTime  @default(now())
  closedAt    DateTime?
  openingCash Decimal   @db.Decimal(12, 2)
  closingCash Decimal?  @db.Decimal(12, 2)

  transactions  Transaction[]
  cashMovements CashMovement[]

  @@index([outletId])
  @@index([kasirId])
  @@map("shifts")
}

model CashMovement {
  id        String   @id @default(uuid())
  shiftId   String
  shift     Shift    @relation(fields: [shiftId], references: [id])
  type      String   // "IN" | "OUT"
  amount    Decimal  @db.Decimal(12, 2)
  note      String?
  createdAt DateTime @default(now())

  @@map("cash_movements")
}

model Transaction {
  id                String             @id @default(uuid())
  outletId          String
  outlet            Outlet             @relation(fields: [outletId], references: [id])
  shiftId           String
  shift             Shift              @relation(fields: [shiftId], references: [id])
  transactionNumber String             @unique
  totalAmount       Decimal            @db.Decimal(12, 2)
  status            TransactionStatus  @default(PENDING)
  createdAt         DateTime           @default(now())

  items    TransactionItem[]
  payments Payment[]

  @@index([outletId, createdAt])
  @@index([status, createdAt])
  @@index([shiftId])
  @@map("transactions")
}

model TransactionItem {
  id            String      @id @default(uuid())
  transactionId String
  transaction   Transaction @relation(fields: [transactionId], references: [id])
  productId     String
  product       Product     @relation(fields: [productId], references: [id])
  qty           Int
  price         Decimal     @db.Decimal(12, 2) // harga saat transaksi (bukan harga produk saat ini)
  subtotal      Decimal     @db.Decimal(12, 2)

  commission    StaffCommission?

  @@index([transactionId])
  @@map("transaction_items")
}

model Payment {
  id            String        @id @default(uuid())
  transactionId String
  transaction   Transaction   @relation(fields: [transactionId], references: [id])
  method        PaymentMethod
  amount        Decimal       @db.Decimal(12, 2)
  gatewayRef    String?       // referensi dari payment gateway (Midtrans/Xendit), null untuk cash
  status        PaymentStatus @default(PENDING)
  createdAt     DateTime      @default(now())

  @@index([transactionId])
  @@map("payments")
}

// ============================================================
// VERTICAL MODULE: BARBERSHOP & SALON (FASE 2)
// ============================================================

model Booking {
  id            String        @id @default(uuid())
  tenantId      String
  tenant        Tenant        @relation(fields: [tenantId], references: [id])
  outletId      String
  outlet        Outlet        @relation(fields: [outletId], references: [id])
  customerName  String
  customerPhone String?
  barberId      String?
  barber        User?         @relation(fields: [barberId], references: [id])
  serviceId     String?
  service       Product?      @relation(fields: [serviceId], references: [id])
  queueNumber   String
  chairNumber   Int?
  status        BookingStatus @default(WAITING)
  notes         String?
  scheduledAt   DateTime      @default(now())
  startedAt     DateTime?
  completedAt   DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([tenantId])
  @@index([outletId, scheduledAt])
  @@index([status])
  @@map("bookings")
}

model StaffCommission {
  id                String          @id @default(uuid())
  tenantId          String
  tenant            Tenant          @relation(fields: [tenantId], references: [id])
  outletId          String
  outlet            Outlet          @relation(fields: [outletId], references: [id])
  staffId           String
  staff             User            @relation(fields: [staffId], references: [id])
  transactionItemId String          @unique
  transactionItem   TransactionItem @relation(fields: [transactionItemId], references: [id])
  commissionType    String          @default("PERCENTAGE") // "PERCENTAGE" | "FLAT"
  rate              Decimal         @db.Decimal(10, 2)     // misal 30.00 (%) atau 15000.00 (Rp)
  amount            Decimal         @db.Decimal(12, 2)     // hasil komisi Rp
  createdAt         DateTime        @default(now())

  @@index([tenantId, createdAt])
  @@index([outletId, createdAt])
  @@index([staffId])
  @@map("staff_commissions")
}

// ============================================================
// VERTICAL MODULE: LAUNDRY KILOAN & SATUAN (FASE 3)
// ============================================================

model LaundryOrder {
  id                   String        @id @default(uuid())
  tenantId             String
  tenant               Tenant        @relation(fields: [tenantId], references: [id])
  outletId             String
  outlet               Outlet        @relation(fields: [outletId], references: [id])
  orderNumber          String        @unique // LND-YYYYMMDD-XXXX
  customerName         String
  customerPhone        String?
  serviceType          String        @default("KILOAN") // "KILOAN" | "SATUAN"
  weightKg             Decimal?      @db.Decimal(6, 2)  // misal 3.50 kg
  unitQty              Int?          // jika satuan
  pricePerUnit         Decimal       @db.Decimal(10, 2)
  totalAmount          Decimal       @db.Decimal(12, 2)
  fragrance            String?       // Lavender, Sakura, Fresh, dll
  status               LaundryStatus @default(RECEIVED)
  notes                String?
  estimatedCompletedAt DateTime?
  receivedAt           DateTime      @default(now())
  completedAt          DateTime?
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  @@index([tenantId])
  @@index([outletId, createdAt])
  @@index([status])
  @@map("laundry_orders")
}

// ============================================================
// VERTICAL MODULE: CAFE & F&B (FASE 3)
// ============================================================

model CafeTable {
  id                String      @id @default(uuid())
  tenantId          String
  tenant            Tenant      @relation(fields: [tenantId], references: [id])
  outletId          String
  outlet            Outlet      @relation(fields: [outletId], references: [id])
  tableNumber       String      // misal "Meja 01", "VIP-1", "Outdoor 3"
  capacity          Int         @default(4)
  areaZone          String?     @default("INDOOR") // "INDOOR" | "OUTDOOR" | "VIP" | "LANTAI_2"
  status            TableStatus @default(AVAILABLE)
  currentGuestName  String?
  currentOrderNotes String?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  @@unique([outletId, tableNumber])
  @@index([tenantId])
  @@index([outletId])
  @@map("cafe_tables")
}

// ============================================================
// PAYROLL SNAPSHOT & ARSIP (FASE 6)
// ============================================================

model PayrollRecord {
  id                  String    @id @default(uuid())
  tenantId            String
  tenant              Tenant    @relation(fields: [tenantId], references: [id])
  staffId             String
  staff               User      @relation(fields: [staffId], references: [id])
  periodMonth         String    // "2026-08"
  cutoffStartDate     DateTime
  cutoffEndDate       DateTime
  salaryType          String
  baseRate            Decimal   @db.Decimal(12, 2)
  workUnits           Int       @default(26) // Hari masuk atau shift kerja
  baseSalaryEarned    Decimal   @db.Decimal(12, 2)
  isProrated          Boolean   @default(false)
  prorateNote         String?
  overtimeHours       Decimal   @default(0) @db.Decimal(6, 2)
  overtimeRate        Decimal   @default(0) @db.Decimal(12, 2)
  overtimePay         Decimal   @default(0) @db.Decimal(12, 2)
  commissionCount     Int       @default(0)
  totalCommissions    Decimal   @default(0) @db.Decimal(12, 2)
  allowanceMeal       Decimal   @default(0) @db.Decimal(12, 2)
  allowanceTransport  Decimal   @default(0) @db.Decimal(12, 2)
  allowanceOther      Decimal   @default(0) @db.Decimal(12, 2)
  customBonus         Decimal   @default(0) @db.Decimal(12, 2)
  deductions          Decimal   @default(0) @db.Decimal(12, 2)
  takeHomePay         Decimal   @db.Decimal(12, 2)
  isLocked            Boolean   @default(false)
  lockedAt            DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@unique([tenantId, staffId, periodMonth])
  @@index([tenantId, periodMonth])
  @@map("payroll_records")
}

// ============================================================
// SYSTEM & VALUE-ADD (FASE 5)
// ============================================================

model BroadcastMessage {
  id        String   @id @default(uuid())
  title     String
  content   String
  type      String   @default("INFO") // "INFO" | "PROMO" | "MAINTENANCE" | "WARNING"
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  @@map("broadcast_messages")
}
